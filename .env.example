# ==============================================================================
# FarmLink Production Environment Configuration Template (.env.example)
# ==============================================================================
# Production Defaults:
# APP_ENV=production
# APP_DEBUG=false
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=FarmLink
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.farmlinkcare.com
FRONTEND_URL=https://farmlinkcare.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & STATEFUL DOMAINS
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=farmlinkcare.com,app.farmlinkcare.com,localhost:3000
CORS_ALLOWED_ORIGINS=https://farmlinkcare.com,https://app.farmlinkcare.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=farmlink_production
DB_USERNAME=farmlink_user
DB_PASSWORD=
DB_SSLMODE=prefer
# DUMP_BINARY_PATH=/usr/bin

# ------------------------------------------------------------------------------
# 4. SESSION, CACHE & QUEUE
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Postmark / SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@farmlinkcare.com"
MAIL_FROM_NAME="FarmLink"
MAIL_REPLY_TO_ADDRESS="support@farmlinkcare.com"
MAIL_REPLY_TO_NAME="FarmLink Care Team"
POSTMARK_API_KEY=

# ------------------------------------------------------------------------------
# 6. SMS GATEWAY (Farmer OTP Verification)
# ------------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=sslwireless
SMS_API_KEY=
SMS_API_SECRET=
SMS_SID=
SMS_SENDER_ID=FarmLink

# ------------------------------------------------------------------------------
# 7. SSLCOMMERZ PAYMENT GATEWAY
# In production: SSLCZ_TESTMODE must be false, with valid merchant credentials!
# ------------------------------------------------------------------------------
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_TESTMODE=false
SSLCOMMERZ_TIMEOUT_MINUTES=45

# ------------------------------------------------------------------------------
# 8. LARAVEL REVERB WEBSOCKETS & BROADCASTING
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb.farmlinkcare.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=https://farmlinkcare.com,https://app.farmlinkcare.com

# ------------------------------------------------------------------------------
# 9. VAPID WEB PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
VAPID_SUBJECT="mailto:admin@farmlinkcare.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 10. ERROR MONITORING (Sentry)
# Monitoring is automatically disabled in local/testing when DSN is empty.
# ------------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_SEND_DEFAULT_PII=false

# ------------------------------------------------------------------------------
# 11. AUTOMATED OFF-SITE BACKUPS & RETENTION (Spatie / S3)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
BACKUP_DISK=backup
BACKUP_DISK_DRIVER=s3
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=us-east-1
BACKUP_AWS_BUCKET=farmlink-cloud-backups
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=admin@farmlinkcare.com
